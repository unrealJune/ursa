<Page
    x:Class="Ursa.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ursa.App.Services"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,16,32,32" Spacing="8" MaxWidth="880" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <InfoBar Severity="Error" IsOpen="{x:Bind HasError(Library.Error), Mode=OneWay}"
                     Message="{x:Bind Library.Error, Mode=OneWay}" CloseButtonClick="OnErrorClosed" />

            <!-- Account -->
            <TextBlock Text="Account" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture DisplayName="{x:Bind Library.AccountName, Mode=OneWay}" Width="44" Height="44" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Library.AccountName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Short(Library.AccountId), Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Devices -->
            <TextBlock Text="Devices" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <ItemsRepeater ItemsSource="{x:Bind Library.Devices}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="services:DeviceRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F8;" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <MenuFlyoutSeparator />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Add a phone or another computer: it gets your account key over an encrypted, post-quantum link, after you confirm the same code on both screens." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddDeviceButton" Content="Add a device" Click="OnAddDevice" />
                        <Button x:Name="CancelLinkButton" Content="Stop" Click="OnCancelLink" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="LinkPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="On the new device, choose “I already use Ursa” › “Link with another device”, and paste:" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LinkCode" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Copy" Click="OnCopyLink" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock x:Name="LinkStatus" Text="Waiting for the other device…" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recovery -->
            <TextBlock Text="Recovery" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Recovery words and key file" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Either one restores your whole account on a new device, even if every node you own is gone. Without one, nobody can." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Show words" Click="OnShowWords" />
                        <Button Content="Save key file…" Click="OnSaveKeyFile" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nodes -->
            <TextBlock Text="Nodes" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Your library is coded across these: yours and your friends'. Any three of five shards rebuild a file, so two can be gone at once." />
                    <ItemsRepeater ItemsSource="{x:Bind Library.Pool}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="services:PoolRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check" Click="OnCheck" />
                        <Button x:Name="RepairButton" Content="Repair" Click="OnRepair"
                                ToolTipService.ToolTip="Rebuild shards that are missing onto nodes that are up" />
                    </StackPanel>
                    <MenuFlyoutSeparator />
                    <TextBlock Text="Add a node you own" />
                    <TextBlock Style="{StaticResource Hint}" Text="Paste the claim link the node printed when it first started (ursa-claim:…)." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClaimLink" PlaceholderText="ursa-claim:…" FontFamily="Consolas" />
                        <TextBox x:Name="NodeLabel" Grid.Column="1" PlaceholderText="Name (optional)" />
                        <Button x:Name="ClaimButton" Grid.Column="2" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="OnClaim" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Friends -->
            <TextBlock Text="Friends" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Friends store shards of your library on their nodes, and you of theirs. Both of you add each other; each sets how much space the other gets. Nobody can read anyone else's files." />
                    <ItemsRepeater ItemsSource="{x:Bind Library.Friends}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="services:FriendRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture DisplayName="{x:Bind Title}" Width="32" Height="32" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button Content="Copy my invite" Click="OnCopyInvite" HorizontalAlignment="Left" />
                    <MenuFlyoutSeparator />
                    <TextBlock Text="Add a friend" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InviteBox" PlaceholderText="ursa-invite:…" FontFamily="Consolas" />
                        <NumberBox x:Name="QuotaBox" Grid.Column="1" Header="" Value="50" Minimum="1" Maximum="100000"
                                   SpinButtonPlacementMode="Compact" PlaceholderText="GB for them" />
                        <Button Grid.Column="2" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="OnBefriend" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Space you give them, in GB, on each of your nodes." />
                </StackPanel>
            </Border>

            <!-- Relays -->
            <TextBlock Text="Relays" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Relays help devices and nodes find each other through firewalls. Data goes directly between them whenever it can. One URL per line." />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Relay URLs" />
                        <TextBox x:Name="RelayUrls" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="64" FontFamily="Consolas"
                                 AutomationProperties.Name="Relay URLs" />
                    </StackPanel>
                    <PasswordBox x:Name="RelayToken" Header="Relay access token" PlaceholderText="Unchanged" />
                    <Button Content="Save and reconnect" Click="OnSaveRelays" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- This PC -->
            <TextBlock Text="This PC" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Device ID" />
                        <TextBlock Text="{x:Bind Short(Library.DeviceId), Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open data folder" Click="OnOpenData" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <TextBlock x:Name="About" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
