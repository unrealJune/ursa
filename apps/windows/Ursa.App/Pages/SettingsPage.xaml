<Page
    x:Class="Ursa.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,16,32,32" Spacing="8" MaxWidth="860" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <InfoBar Severity="Error" IsOpen="{x:Bind HasError(Library.Error), Mode=OneWay}"
                     Message="{x:Bind Library.Error, Mode=OneWay}" CloseButtonClick="OnErrorClosed" />

            <TextBlock Text="Home node" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE968;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Library.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Library.DetailText, Mode=OneWay}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Short(Library.NodeId), Mode=OneWay}" IsTextSelectionEnabled="True"
                                       Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Check" Click="OnCheck" />
                            <Button Content="Forget" Click="OnForget" IsEnabled="{x:Bind Library.IsConfigured, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <MenuFlyoutSeparator />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Text="To add this PC to a node, paste the claim link the node printed (ursa-claim:…). The node only ever sees encrypted data; this PC holds the key." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClaimLink" PlaceholderText="ursa-claim:…" FontFamily="Consolas" />
                        <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect"
                                Style="{StaticResource AccentButtonStyle}" Click="OnConnect" />
                    </Grid>
                    <ProgressBar x:Name="ConnectProgress" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock Text="Relays" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Relays help this PC find its node and connect through firewalls. Data goes directly between them whenever it can. One URL per line." />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Relay URLs" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBox x:Name="RelayUrls" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="64" FontFamily="Consolas"
                                 AutomationProperties.Name="Relay URLs" />
                    </StackPanel>
                    <PasswordBox x:Name="RelayToken" Header="Relay access token" PlaceholderText="Unchanged" />
                    <Button Content="Save and reconnect" Click="OnSaveRelays" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="This PC" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Device ID" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Short(Library.DeviceId), Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open data folder" Click="OnOpenData" VerticalAlignment="Center" />
                    </Grid>
                    <MenuFlyoutSeparator />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recovery key" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Everything in your library is encrypted with this key. Without it nobody, including you, can read it again. Keep a copy somewhere safe." />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Show" Click="OnShowKey" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <Border Style="{StaticResource Card}">
                <TextBlock x:Name="About" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
