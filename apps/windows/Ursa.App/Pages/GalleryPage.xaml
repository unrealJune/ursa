<Page
    x:Class="Ursa.App.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Ursa.App.Services"
    Background="Transparent"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="U" Modifiers="Control" Invoked="OnUploadAccelerator" />
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="32,16,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Library" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                <AppBarButton x:Name="UploadButton" Label="Upload" Click="OnUpload"
                              IsEnabled="{x:Bind Library.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="Upload files (Ctrl+U)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DownloadButton" Label="Download" Click="OnDownload" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Delete" Click="OnDelete" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Refresh" Click="OnRefresh" LabelPosition="Collapsed"
                              IsEnabled="{x:Bind Library.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar Grid.Row="1" Margin="32,0,24,8" Severity="Warning"
                 IsOpen="{x:Bind HasError(Library.Error), Mode=OneWay}"
                 Message="{x:Bind Library.Error, Mode=OneWay}"
                 CloseButtonClick="OnErrorClosed" />

        <!-- The gallery: justified rows of thumbnails. -->
        <ItemsView x:Name="Gallery" Grid.Row="2" Padding="24,0,24,24"
                   ItemsSource="{x:Bind Library.Items}"
                   SelectionMode="Extended"
                   IsItemInvokedEnabled="True"
                   ItemInvoked="OnItemInvoked"
                   SelectionChanged="OnSelectionChanged">
            <ItemsView.Layout>
                <LinedFlowLayout x:Name="Flow" LineHeight="200" LineSpacing="6" MinItemSpacing="6"
                                 ItemsStretch="Fill" ItemsInfoRequested="OnItemsInfoRequested" />
            </ItemsView.Layout>
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="services:GalleryItem">
                    <ItemContainer AutomationProperties.Name="{x:Bind Name}" CornerRadius="6">
                        <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="{x:Bind Name}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="36"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{x:Bind ShowGlyph, Mode=OneWay}" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <Border Visibility="{x:Bind IsVideo}" Margin="8" Padding="6,3"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="4"
                                    Background="{ThemeResource SmokeFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" />
                            </Border>
                            <TextBlock Visibility="{x:Bind ShowGlyph, Mode=OneWay}" Text="{x:Bind Name}"
                                       Margin="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
        </ItemsView>

        <!-- Empty and not-connected states sit where the gallery would be. -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="12" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <FontIcon Glyph="&#xE91B;" FontSize="56" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" Text="Your library is empty" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Drop photos, videos or any files here, or upload them. They're encrypted on this PC before they leave it." />
            <Button x:Name="EmptyAction" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    Content="Upload files" Click="OnEmptyAction" Margin="0,8,0,0" />
        </StackPanel>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind Library.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Transfers -->
        <Border Grid.Row="3" Visibility="{x:Bind Library.IsTransferring, Mode=OneWay}"
                Margin="24,0,24,16" Padding="16,12" CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Library.TransferText, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Grid.Column="1" Value="{x:Bind Library.TransferPercent, Mode=OneWay}"
                             Maximum="100" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Drop target highlight -->
        <Border x:Name="DropHint" Grid.RowSpan="4" Visibility="Collapsed" Margin="16" CornerRadius="12"
                BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE898;" FontSize="40" />
                <TextBlock Text="Drop to upload" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Border>

        <!-- Viewer -->
        <Grid x:Name="Viewer" Grid.RowSpan="4" Visibility="Collapsed"
              Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
              KeyDown="OnViewerKeyDown" IsTabStop="True" TabFocusNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="OnCloseViewer" AutomationProperties.Name="Back to library"
                        ToolTipService.ToolTip="Back (Esc)" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ViewerTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ViewerDetails" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Click="OnViewerDownload" ToolTipService.ToolTip="Download" Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="Download">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                    </Button>
                    <Button Click="OnViewerDelete" ToolTipService.ToolTip="Delete" Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="Delete">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Padding="24,0,24,24">
                <Image x:Name="ViewerImage" Stretch="Uniform" />
                <MediaPlayerElement x:Name="ViewerVideo" AreTransportControlsEnabled="True" Visibility="Collapsed" />
                <StackPanel x:Name="ViewerFallback" Visibility="Collapsed" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon x:Name="ViewerGlyph" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="ViewerFallbackText" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressRing x:Name="ViewerLoading" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="PrevButton" Click="OnPrevious" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Previous"
                        ToolTipService.ToolTip="Previous (Left)" Width="44" Height="64">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>
                <Button x:Name="NextButton" Click="OnNext" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Next"
                        ToolTipService.ToolTip="Next (Right)" Width="44" Height="64">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
