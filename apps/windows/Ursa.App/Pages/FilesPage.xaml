<Page
    x:Class="Ursa.App.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ursa.App.Pages"
    Background="Transparent"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="U" Modifiers="Control" Invoked="OnUploadAccelerator" />
        <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="OnNewFolderAccelerator" />
        <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Back" Invoked="OnUpAccelerator" />
        <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="32,16,24,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Files" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                <AppBarButton x:Name="NewFolderButton" Label="New folder" Click="OnNewFolder"
                              IsEnabled="{x:Bind Library.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="New folder (Ctrl+Shift+N)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="UploadButton" Label="Upload"
                              IsEnabled="{x:Bind Library.IsConnected, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Name="UploadFilesItem" Text="Files…" Click="OnUploadFiles">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="UploadFolderItem" Text="Folder…" Click="OnUploadFolder">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="OpenButton" Label="Open" Click="OnOpen" IsEnabled="False"
                              ToolTipService.ToolTip="Open (Enter)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DownloadButton" Label="Download" Click="OnDownload" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RenameButton" Label="Rename" Click="OnRename" IsEnabled="False"
                              ToolTipService.ToolTip="Rename (F2)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="MoveButton" Label="Move to" Click="OnMove" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8DE;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Delete" Click="OnDelete" IsEnabled="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="RefreshButton" Label="Refresh" Click="OnRefresh" LabelPosition="Collapsed"
                              IsEnabled="{x:Bind Library.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Where you are -->
        <BreadcrumbBar x:Name="Crumbs" Grid.Row="1" Margin="32,8,24,8" ItemClicked="OnCrumbClicked"
                       AutomationProperties.Name="Folder path">

        </BreadcrumbBar>

        <InfoBar Grid.Row="2" Margin="32,0,24,8" Severity="Warning"
                 IsOpen="{x:Bind HasError(Library.Error), Mode=OneWay}"
                 Message="{x:Bind Library.Error, Mode=OneWay}"
                 CloseButtonClick="OnErrorClosed" />

        <!-- Column heads -->
        <Grid Grid.Row="3" Margin="24,0,24,0" Padding="16,6,16,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Modified" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="Size" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView x:Name="List" Grid.Row="4" Padding="24,0,24,24"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  DoubleTapped="OnDoubleTapped"
                  KeyDown="OnListKeyDown"
                  SelectionChanged="OnSelectionChanged"
                  AutomationProperties.Name="Files and folders">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileRow">
                    <Grid ColumnSpacing="16" Padding="0,8" AutomationProperties.Name="{x:Bind Name}"
                          ContextRequested="OnRowContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18"
                                  Foreground="{x:Bind GlyphBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind DateText}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="4" Spacing="12" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <FontIcon Glyph="&#xE8B7;" FontSize="56" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyTitle" Text="This folder is empty" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyBody" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Drop files or folders here, or upload them. They're encrypted on this PC before they leave it." />
        </StackPanel>

        <ProgressRing Grid.Row="4" IsActive="{x:Bind Library.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Transfers -->
        <Border Grid.Row="5" Visibility="{x:Bind Library.IsTransferring, Mode=OneWay}"
                Margin="24,0,24,16" Padding="16,12" CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Library.TransferText, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Grid.Column="1" Value="{x:Bind Library.TransferPercent, Mode=OneWay}"
                             Maximum="100" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="DropHint" Grid.RowSpan="6" Visibility="Collapsed" Margin="16" CornerRadius="12"
                BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE898;" FontSize="40" />
                <TextBlock x:Name="DropText" Text="Drop to upload here" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
